{# Semantic TUI primitives. Import with: {% from 'widgets.jinja' import screen, pane, stack, status_bar, key_hints %} #}
{% macro screen(title='', status='') -%}
<div class="mk-screen">{% if title %}<header class="mk-screen__title"><h1>{{ title }}</h1></header>{% endif %}{{ caller() }}{% if status %}<footer class="mk-screen__status" aria-label="Status">{{ status }}</footer>{% endif %}</div>
{%- endmacro %}
{% macro pane(title='', label='', level=2) -%}
<section class="mk-pane"{% if label and not title %} aria-label="{{ label }}"{% endif %}>{% if title %}{% if level == 3 %}<h3>{{ title }}</h3>{% elif level == 4 %}<h4>{{ title }}</h4>{% elif level == 5 %}<h5>{{ title }}</h5>{% elif level >= 6 %}<h6>{{ title }}</h6>{% else %}<h2>{{ title }}</h2>{% endif %}{% endif %}{{ caller() }}</section>
{%- endmacro %}
{% macro stack() -%}<div class="mk-stack">{{ caller() }}</div>{%- endmacro %}
{% macro split() -%}<div class="mk-split">{{ caller() }}</div>{%- endmacro %}
{% macro list(label='', ordered=false) -%}{% if ordered %}<ol class="mk-list"{% if label %} aria-label="{{ label }}"{% endif %}>{{ caller() }}</ol>{% else %}<ul class="mk-list"{% if label %} aria-label="{{ label }}"{% endif %}>{{ caller() }}</ul>{% endif %}{%- endmacro %}
{% macro tree(label='') -%}<nav class="mk-tree"{% if label %} aria-label="{{ label }}"{% endif %}><ul>{{ caller() }}</ul></nav>{%- endmacro %}
{% macro table(caption='') -%}<table class="mk-table">{% if caption %}<caption>{{ caption }}</caption>{% endif %}{{ caller() }}</table>{%- endmacro %}
{% macro tabs(label='Sections') -%}<nav class="mk-tabs" aria-label="{{ label }}"><ul>{{ caller() }}</ul></nav>{%- endmacro %}
{% macro article(id='') -%}<article class="mk-article"{% if id %} id="{{ id }}"{% endif %}>{{ caller() }}</article>{%- endmacro %}
{% macro status_bar() -%}<div class="mk-status-bar" role="status">{{ caller() }}</div>{%- endmacro %}
{% macro key_hints() -%}<nav class="mk-key-hints" aria-label="Keyboard shortcuts"><ul>{{ caller() }}</ul></nav>{%- endmacro %}
{% macro dialog(title='Details') -%}<details class="mk-dialog"><summary>{{ title or 'Details' }}</summary><div class="mk-dialog__content">{{ caller() }}</div></details>{%- endmacro %}
